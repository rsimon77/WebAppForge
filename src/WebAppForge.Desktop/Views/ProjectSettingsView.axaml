<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WebAppForge.Desktop.Localization"
             xmlns:vm="using:WebAppForge.Desktop.ViewModels"
             x:Class="WebAppForge.Desktop.Views.ProjectSettingsView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Classes="card" Margin="12" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Spacing="8" DataContext="{Binding ProjectSettings}">

                <TextBlock Classes="hint" Text="{l:Tr ProjectSettings_SettingsOfTheWholeProjectChanges}" />
                <Border IsVisible="{Binding HasMessage}" Classes="banner error">
                    <TextBlock Classes="error" Text="{Binding Message}" AutomationProperties.AutomationId="ProjectMessageText" />
                </Border>

                <Expander Header="{l:Tr ProjectSettings_Identity}" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Classes="label" Text="{l:Tr Common_ProjectName}" />
                        <TextBox Text="{Binding Name}" AutomationProperties.AutomationId="ProjectIdentityNameBox" />

                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_ProjectId}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding ProjectId, Mode=OneWay}" IsReadOnly="True" Width="340"
                                     AutomationProperties.AutomationId="ProjectIdBox" />
                            <Button Content="{l:Tr ProjectSettings_Regenerate}" Command="{Binding RegenerateProjectIdCommand}"
                                    AutomationProperties.AutomationId="RegenerateProjectIdButton" />
                        </StackPanel>

                        <TextBlock Classes="label" Text="{l:Tr Common_Description}" />
                        <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                 AutomationProperties.AutomationId="ProjectDescriptionBox" />

                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Author}" />
                        <TextBox Text="{Binding Author}" AutomationProperties.AutomationId="ProjectAuthorBox" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Company}" />
                        <TextBox Text="{Binding Company}" AutomationProperties.AutomationId="ProjectCompanyBox" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Copyright}" />
                        <TextBox Text="{Binding Copyright}" AutomationProperties.AutomationId="ProjectCopyrightBox" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Version}" />
                        <TextBox Text="{Binding Version}" Width="200" HorizontalAlignment="Left"
                                 AutomationProperties.AutomationId="ProjectVersionBox" />
                    </StackPanel>
                </Expander>

                <Expander Header="{l:Tr Common_Output}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_OutputFolderRelativeToTheProject}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Tr Common_Browse}" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}"
                                    AutomationProperties.AutomationId="BrowseOutputFolderButton" />
                            <TextBox Text="{Binding OutputFolder}" AutomationProperties.AutomationId="OutputFolderBox" />
                        </DockPanel>
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_RootNamespaceEmptyFromTheProject}" />
                        <TextBox Text="{Binding RootNamespace}" AutomationProperties.AutomationId="RootNamespaceBox" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_AssemblyNameEmptyFromTheProject}" />
                        <TextBox Text="{Binding AssemblyName}" AutomationProperties.AutomationId="AssemblyNameBox" />
                    </StackPanel>
                </Expander>

                <Expander Header="{l:Tr ProjectSettings_Site}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_ASPNETApplicationTitle}" />
                        <TextBox Text="{Binding SiteTitle}" AutomationProperties.AutomationId="SiteTitleBox" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Theme}" />
                        <ComboBox ItemsSource="{x:Static vm:CustomizationChoices.Themes}" SelectedItem="{Binding Theme}"
                                  MinWidth="200" AutomationProperties.AutomationId="SiteThemeCombo" />
                        <CheckBox Content="{l:Tr Common_IncludeHomePage}" IsChecked="{Binding IncludeHomePage}"
                                  AutomationProperties.AutomationId="IncludeHomePageCheck" />

                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Favicon}" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                <Button Content="{l:Tr Common_Browse}" Command="{Binding BrowseFaviconCommand}" AutomationProperties.AutomationId="BrowseFaviconButton" />
                                <Button Content="{l:Tr Common_Clear}" Command="{Binding ClearFaviconCommand}" AutomationProperties.AutomationId="ClearFaviconButton" />
                            </StackPanel>
                            <TextBox Text="{Binding FaviconPath}" AutomationProperties.AutomationId="FaviconPathBox" />
                        </DockPanel>
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Logo}" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                <Button Content="{l:Tr Common_Browse}" Command="{Binding BrowseLogoCommand}" AutomationProperties.AutomationId="BrowseLogoButton" />
                                <Button Content="{l:Tr Common_Clear}" Command="{Binding ClearLogoCommand}" AutomationProperties.AutomationId="ClearLogoButton" />
                            </StackPanel>
                            <TextBox Text="{Binding LogoPath}" AutomationProperties.AutomationId="LogoPathBox" />
                        </DockPanel>

                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_FooterText}" />
                        <TextBox Text="{Binding FooterText}" AutomationProperties.AutomationId="FooterTextBox" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="{l:Tr ProjectSettings_ColorMode}" />
                                <ComboBox ItemsSource="{x:Static vm:CustomizationChoices.ColorModes}" SelectedItem="{Binding ColorMode}"
                                          MinWidth="160" AutomationProperties.AutomationId="ColorModeCombo" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="{l:Tr ProjectSettings_NavbarStyle}" />
                                <ComboBox ItemsSource="{x:Static vm:ContextStyles.Names}" SelectedItem="{Binding NavbarStyle}"
                                          MinWidth="160" AutomationProperties.AutomationId="NavbarStyleCombo">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="14" Height="14" CornerRadius="3" BorderThickness="1"
                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                        Background="{Binding Converter={x:Static vm:StyleSwatchConverter.Instance}}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="{l:Tr ProjectSettings_Runtime}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Environment}" />
                                <ComboBox ItemsSource="{x:Static vm:CustomizationChoices.Environments}" SelectedItem="{Binding Environment}"
                                          MinWidth="160" AutomationProperties.AutomationId="EnvironmentCombo" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="{l:Tr Common_LogLevel}" />
                                <ComboBox ItemsSource="{x:Static vm:CustomizationChoices.LogLevels}" SelectedItem="{Binding LogLevel}"
                                          MinWidth="160" AutomationProperties.AutomationId="LogLevelCombo" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="{l:Tr ProjectSettings_HTTPPort165535}" />
                                <TextBox Text="{Binding HttpPortText}" Width="160" AutomationProperties.AutomationId="HttpPortBox" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="{l:Tr ProjectSettings_HTTPSPort165535}" />
                                <TextBox Text="{Binding HttpsPortText}" Width="160" AutomationProperties.AutomationId="HttpsPortBox" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Content="{l:Tr ProjectSettings_UseHTTPS}" IsChecked="{Binding UseHttps}" AutomationProperties.AutomationId="UseHttpsCheck" />
                        <CheckBox Content="{l:Tr ProjectSettings_SendHSTSHeadersNeedsHTTPS}" IsChecked="{Binding EnableHsts}" IsEnabled="{Binding CanUseHsts}"
                                  AutomationProperties.AutomationId="EnableHstsCheck" />
                        <CheckBox Content="{l:Tr ProjectSettings_CompressResponses}" IsChecked="{Binding EnableResponseCompression}"
                                  AutomationProperties.AutomationId="ResponseCompressionCheck" />
                        <CheckBox Content="{l:Tr ProjectSettings_AddAHealthEndpoint}" IsChecked="{Binding EnableHealthEndpoint}"
                                  AutomationProperties.AutomationId="HealthEndpointCheck" />
                    </StackPanel>
                </Expander>

                <Expander Header="{l:Tr ProjectSettings_GlobalCSS}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Classes="hint" Text="{l:Tr ProjectSettings_AddedToEveryPageOfThe}" />
                        <TextBox Classes="code" Text="{Binding GlobalCss}" Height="160" AutomationProperties.AutomationId="GlobalCssBox" />
                    </StackPanel>
                </Expander>

                <Expander Header="{l:Tr ProjectSettings_GlobalScript}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Classes="hint" Text="{l:Tr ProjectSettings_JavaScriptAddedToEveryPageOf}" />
                        <TextBox Classes="code" Text="{Binding GlobalScript}" Height="160" AutomationProperties.AutomationId="GlobalScriptBox" />
                    </StackPanel>
                </Expander>

                <Expander Header="{l:Tr Common_Database}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Provider}" />
                        <TextBox Text="{Binding Provider, Mode=OneWay}" IsReadOnly="True" Width="200" HorizontalAlignment="Left"
                                 AutomationProperties.AutomationId="ProviderBox" />
                        <StackPanel Spacing="4" IsVisible="{Binding IsSqlite}">
                            <TextBlock Classes="label" Text="{l:Tr ProjectSettings_SQLiteFilePath}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Tr Common_Browse}" Margin="8,0,0,0" Command="{Binding BrowseDatabaseCommand}"
                                        AutomationProperties.AutomationId="BrowseDatabaseButton" />
                                <TextBox Text="{Binding DatabasePath}" AutomationProperties.AutomationId="ProjectDatabasePathBox" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding !IsSqlite}">
                            <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Connection}" />
                            <TextBox Text="{Binding ServerConnection, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.AutomationId="ProjectServerConnectionBox" />
                        </StackPanel>
                        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:Tr ProjectSettings_ChangeTheEngineAndTheConnection}" />
                    </StackPanel>
                </Expander>

                <Expander Header="{l:Tr ProjectSettings_BuildAndDocker}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <CheckBox Content="{l:Tr Common_BuildAfterGenerating}" IsChecked="{Binding BuildAfterGenerate}" AutomationProperties.AutomationId="BuildAfterGenerateCheck" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Configuration}" />
                        <ComboBox ItemsSource="{x:Static vm:CustomizationChoices.Configurations}" SelectedItem="{Binding Configuration}"
                                  MinWidth="160" AutomationProperties.AutomationId="ConfigurationCombo" />
                        <CheckBox Content="{l:Tr ProjectSettings_PublishInsteadOfBuild}" IsChecked="{Binding Publish}" AutomationProperties.AutomationId="PublishCheck" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_PublishFolderRelativeToTheOutput}" />
                        <TextBox Text="{Binding PublishFolder}" AutomationProperties.AutomationId="PublishFolderBox" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_RuntimeIdentifierForExampleWinX64}" />
                        <TextBox Text="{Binding RuntimeIdentifier}" AutomationProperties.AutomationId="RuntimeIdentifierBox" />
                        <CheckBox Content="{l:Tr ProjectSettings_SelfContained}" IsChecked="{Binding SelfContained}" AutomationProperties.AutomationId="SelfContainedCheck" />

                        <CheckBox Content="{l:Tr ProjectSettings_GenerateADockerfile}" IsChecked="{Binding GenerateDockerfile}" Margin="0,8,0,0"
                                  AutomationProperties.AutomationId="GenerateDockerfileCheck" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_ImageNameEmptyTheProjectName}" />
                        <TextBox Text="{Binding DockerImageName}" AutomationProperties.AutomationId="DockerImageNameBox" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_ExposedPort165535}" />
                        <TextBox Text="{Binding DockerExposePortText}" Width="160" HorizontalAlignment="Left"
                                 AutomationProperties.AutomationId="DockerExposePortBox" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_BaseSDKImage}" />
                        <TextBox Text="{Binding DockerBaseSdkImage}" AutomationProperties.AutomationId="DockerSdkImageBox" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_BaseRuntimeImage}" />
                        <TextBox Text="{Binding DockerBaseRuntimeImage}" AutomationProperties.AutomationId="DockerRuntimeImageBox" />
                        <CheckBox Content="{l:Tr ProjectSettings_GenerateDockerComposeFile}" IsChecked="{Binding GenerateCompose}" AutomationProperties.AutomationId="GenerateComposeCheck" />
                        <CheckBox Content="{l:Tr ProjectSettings_BuildTheDockerImageAfterGenerating}" IsChecked="{Binding BuildDockerImage}"
                                  AutomationProperties.AutomationId="BuildDockerImageCheck" />
                    </StackPanel>
                </Expander>

                <Expander Header="{l:Tr ProjectSettings_SecurityAndLocalization}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <TextBlock Classes="label" Text="{l:Tr Common_Security}" />
                        <TextBlock Text="{Binding SecuritySummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="SecuritySummaryText" />
                        <Button Content="{l:Tr ProjectSettings_GoToSecurityTab}" Command="{Binding ShowSecurityTabCommand}" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="GoToSecurityButton" />
                        <TextBlock Classes="label" Text="{l:Tr ProjectSettings_Localization}" />
                        <TextBlock Text="{Binding LocalizationSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="LocalizationSummaryText" />
                        <Button Content="{l:Tr ProjectSettings_GoToLanguagesTab}" Command="{Binding ShowLocalizationTabCommand}" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="GoToLocalizationButton" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
