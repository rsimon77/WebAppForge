<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WebAppForge.Desktop.Views.UnsavedChangesWindow"
        Title="Unsaved changes"
        Width="440" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock TextWrapping="Wrap"
                   Text="The open project has unsaved changes. Save them before you continue?" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Save" IsDefault="True" Click="OnSaveClick" />
            <Button Content="Discard" Click="OnDiscardClick" />
            <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
