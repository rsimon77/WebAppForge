<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WebAppForge.Desktop.Localization"
             x:Class="WebAppForge.Desktop.Views.ReportsView">
    <Grid DataContext="{Binding Reports}" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" MinWidth="320" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="6*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- Left: the reports of the project and the problem list. -->
        <Border Classes="card" Padding="12,10" Grid.Column="0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="{l:Tr Common_Reports}" />
                    <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" MinHeight="120" MaxHeight="320"
                             AutomationProperties.AutomationId="ReportList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel>
                        <Button Content="{l:Tr Reports_AddReport}" Margin="0,0,6,6" Command="{Binding AddReportCommand}" AutomationProperties.AutomationId="AddReportButton" />
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_Remove}" AutomationProperties.Name="{l:Tr Common_Remove}" Margin="0,0,2,4" Command="{Binding RemoveReportCommand}" AutomationProperties.AutomationId="RemoveReportButton"><Path Classes="icon" Data="{StaticResource IconRemove}" /></Button>
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_MoveUp}" AutomationProperties.Name="{l:Tr Common_MoveUp}" Margin="0,0,2,4" Command="{Binding MoveReportUpCommand}" AutomationProperties.AutomationId="MoveReportUpButton"><Path Classes="icon" Data="{StaticResource IconUp}" /></Button>
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_MoveDown}" AutomationProperties.Name="{l:Tr Common_MoveDown}" Margin="0,0,2,4" Command="{Binding MoveReportDownCommand}" AutomationProperties.AutomationId="MoveReportDownButton"><Path Classes="icon" Data="{StaticResource IconDown}" /></Button>
                    </WrapPanel>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="{l:Tr Reports_AReportReadsOneTableThe}" />

                    <Expander Header="{l:Tr Common_Preview}" IsExpanded="True" HorizontalAlignment="Stretch" IsEnabled="{Binding HasReport}">
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Tr Common_Preview}" Classes="primary" Command="{Binding PreviewCommand}"
                                    AutomationProperties.AutomationId="ReportPreviewButton" />
                            <TextBlock Classes="hint" Text="{Binding PreviewMessage}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       AutomationProperties.AutomationId="ReportPreviewMessage" />
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel AutomationProperties.AutomationId="ReportPreviewTable">
                                <ItemsControl ItemsSource="{Binding PreviewHeaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Width="110" Classes="section" TextTrimming="CharacterEllipsis" Margin="0,0,6,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding PreviewRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Width="110" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border IsVisible="{Binding HasBar}" Width="{Binding BarWidth}" Height="10" CornerRadius="3"
                                                            Background="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Classes="hint" Text="{l:Tr Reports_OwnerFieldsAndUserLevelsAre}" />
                    </StackPanel>
                </Expander>

                <Expander Header="{l:Tr Common_Validation}" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <TextBlock Classes="hint" Text="{Binding ProblemSummary}" AutomationProperties.AutomationId="ReportProblemSummaryText" />
                            <ItemsControl ItemsSource="{Binding Problems}" AutomationProperties.AutomationId="ReportProblemList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="error" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- Right: the selected report. -->
        <Border Classes="card" Padding="12,10" Grid.Column="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" Margin="0,0,8,0" IsEnabled="{Binding HasReport}">
                    <Border IsVisible="{Binding HasMessage}" Classes="banner error">
                        <TextBlock Classes="error" Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="ReportMessageText" />
                    </Border>

                    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
                        <TextBlock Classes="label" Text="{l:Tr Common_Name}" />
                        <TextBox Grid.Row="1" Text="{Binding Name}" AutomationProperties.AutomationId="ReportNameBox" />
                        <TextBlock Grid.Column="2" Classes="label" Text="{l:Tr Common_Kind}" />
                        <ComboBox Grid.Column="2" Grid.Row="1" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="ReportKindCombo" />
                    </Grid>
                    <TextBlock Classes="hint" Text="{Binding Route}" AutomationProperties.AutomationId="ReportRouteText" />

                    <TextBlock Classes="label" Text="{l:Tr Reports_CaptionEmptyTheName}" />
                    <TextBox Text="{Binding Caption}" AutomationProperties.AutomationId="ReportCaptionBox" />
                    <TextBlock Classes="label" Text="{l:Tr Reports_DescriptionShownUnderTheHeading}" />
                    <TextBox Text="{Binding Description}" AutomationProperties.AutomationId="ReportDescriptionBox" />

                    <StackPanel Spacing="4" IsVisible="{Binding HasSource}">
                        <TextBlock Classes="label" Text="{l:Tr Common_Table}" />
                        <ComboBox ItemsSource="{Binding TableNames}" SelectedItem="{Binding SourceTable}" MinWidth="240"
                                  AutomationProperties.AutomationId="ReportTableCombo" />
                        <TextBlock Classes="label" Text="{l:Tr Reports_FilterSQLWithoutWHEREAddedTo}" />
                        <TextBox Classes="code" Text="{Binding Filter}" AutomationProperties.AutomationId="ReportFilterBox" />
                    </StackPanel>

                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="{l:Tr Common_Generate}" Margin="0,0,16,0" IsChecked="{Binding Generate}" AutomationProperties.AutomationId="ReportGenerateCheck" />
                        <CheckBox Content="{l:Tr Common_ShowInMenu}" Margin="0,0,16,0" IsChecked="{Binding ShowInMenu}" AutomationProperties.AutomationId="ReportShowInMenuCheck" />
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
                        <TextBlock Classes="label" Text="{l:Tr Reports_MenuGroupEmptyWithTheTables}" />
                        <TextBox Grid.Row="1" Text="{Binding MenuGroup}" AutomationProperties.AutomationId="ReportMenuGroupBox" />
                        <TextBlock Grid.Column="2" Classes="label" Text="{l:Tr Reports_LowestUserLevel0AnyUser}" />
                        <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding MinLevel}" AutomationProperties.AutomationId="ReportMinLevelBox" />
                    </Grid>

                    <!-- Summary -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsSummary}" Margin="0,8,0,0">
                        <TextBlock Classes="label" Text="{l:Tr Reports_GroupByOutermostFirst}" />
                        <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" AutoGenerateColumns="False"
                                  GridLinesVisibility="All" SelectionMode="Single" MinHeight="80" MaxHeight="180" HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="ReportGroupsGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:Tr Common_Field}" Width="*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Reports.FieldNames}"
                                                      SelectedItem="{Binding Field}" Margin="2,0" MinWidth="140" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:Tr Reports_GroupDatesBy}" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Reports.IntervalChoices}"
                                                      SelectedItem="{Binding Interval}" Margin="2,0" MinWidth="110" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="{l:Tr Reports_Descending}" Binding="{Binding Descending}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <Button Content="{l:Tr Reports_AddGroup}" Margin="0,0,6,6" Command="{Binding AddGroupCommand}" AutomationProperties.AutomationId="AddReportGroupButton" />
                            <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_Remove}" AutomationProperties.Name="{l:Tr Common_Remove}" Margin="0,0,2,4" Command="{Binding RemoveGroupCommand}" AutomationProperties.AutomationId="RemoveReportGroupButton"><Path Classes="icon" Data="{StaticResource IconRemove}" /></Button>
                        </WrapPanel>

                        <TextBlock Classes="label" Text="{l:Tr Reports_TotalsNoneARowCount}" />
                        <DataGrid ItemsSource="{Binding Aggregates}" SelectedItem="{Binding SelectedAggregate, Mode=TwoWay}" AutoGenerateColumns="False"
                                  GridLinesVisibility="All" SelectionMode="Single" MinHeight="80" MaxHeight="180" HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="ReportAggregatesGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:Tr Reports_Function}" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Reports.FunctionChoices}"
                                                      SelectedItem="{Binding Function}" Margin="2,0" MinWidth="100" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:Tr Common_Field}" Width="*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Reports.ValueFieldNames}"
                                                      SelectedItem="{Binding Field}" Margin="2,0" MinWidth="140" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:Tr Reports_HeadingEmptyEGSumOf}" Binding="{Binding Caption}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <Button Content="{l:Tr Reports_AddTotal}" Margin="0,0,6,6" Command="{Binding AddAggregateCommand}" AutomationProperties.AutomationId="AddReportAggregateButton" />
                            <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_Remove}" AutomationProperties.Name="{l:Tr Common_Remove}" Margin="0,0,2,4" Command="{Binding RemoveAggregateCommand}" AutomationProperties.AutomationId="RemoveReportAggregateButton"><Path Classes="icon" Data="{StaticResource IconRemove}" /></Button>
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox Content="{l:Tr Reports_ListTheRowsOfEachGroup}" Margin="0,0,16,0" IsChecked="{Binding ShowDetails}" AutomationProperties.AutomationId="ReportShowDetailsCheck" />
                            <CheckBox Content="{l:Tr Reports_GrandTotal}" IsChecked="{Binding ShowGrandTotal}" AutomationProperties.AutomationId="ReportGrandTotalCheck" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Row columns: listed under each group, and on the drill-down page. -->
                    <StackPanel Spacing="4" IsVisible="{Binding HasDrillDown}" Margin="0,8,0,0">
                        <TextBlock Classes="label" Text="{l:Tr Reports_RowColumnsForListedRowsAnd}" TextWrapping="Wrap" />
                        <DataGrid ItemsSource="{Binding DetailColumns}" SelectedItem="{Binding SelectedDetailColumn, Mode=TwoWay}" AutoGenerateColumns="False"
                                  GridLinesVisibility="All" SelectionMode="Single" MinHeight="70" MaxHeight="180" HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="ReportDetailColumnsGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:Tr Common_Field}" Width="*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Reports.FieldNames}"
                                                      SelectedItem="{Binding Field}" Margin="2,0" MinWidth="160" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <Button Content="{l:Tr Common_AddColumn}" Margin="0,0,6,6" Command="{Binding AddDetailColumnCommand}" AutomationProperties.AutomationId="AddReportColumnButton" />
                            <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_Remove}" AutomationProperties.Name="{l:Tr Common_Remove}" Margin="0,0,2,4" Command="{Binding RemoveDetailColumnCommand}" AutomationProperties.AutomationId="RemoveReportColumnButton"><Path Classes="icon" Data="{StaticResource IconRemove}" /></Button>
                            <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_MoveUp}" AutomationProperties.Name="{l:Tr Common_MoveUp}" Margin="0,0,2,4" Command="{Binding MoveDetailColumnUpCommand}" AutomationProperties.AutomationId="MoveReportColumnUpButton"><Path Classes="icon" Data="{StaticResource IconUp}" /></Button>
                            <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_MoveDown}" AutomationProperties.Name="{l:Tr Common_MoveDown}" Margin="0,0,2,4" Command="{Binding MoveDetailColumnDownCommand}" AutomationProperties.AutomationId="MoveReportColumnDownButton"><Path Classes="icon" Data="{StaticResource IconDown}" /></Button>
                        </WrapPanel>
                        <CheckBox Content="{l:Tr Reports_LinkTheNumbersToTheRows}" IsChecked="{Binding DrillDown}" AutomationProperties.AutomationId="ReportDrillDownCheck" />
                    </StackPanel>

                    <!-- Crosstab and chart -->
                    <StackPanel Spacing="4" IsVisible="{Binding UsesGrid}" Margin="0,8,0,0">
                        <Grid ColumnDefinitions="*,12,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Classes="label" Text="{Binding RowFieldLabel}" />
                            <ComboBox Grid.Row="1" ItemsSource="{Binding FieldNames}" SelectedItem="{Binding RowField}" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="ReportRowFieldCombo" />
                            <TextBlock Grid.Column="2" Classes="label" Text="{l:Tr Reports_GroupDatesBy}" />
                            <ComboBox Grid.Column="2" Grid.Row="1" ItemsSource="{Binding IntervalChoices}" SelectedItem="{Binding RowInterval}" MinWidth="120"
                                      AutomationProperties.AutomationId="ReportRowIntervalCombo" />
                            <TextBlock Grid.Row="2" Classes="label" Text="{Binding ColumnFieldLabel}" />
                            <ComboBox Grid.Row="3" ItemsSource="{Binding OptionalFieldNames}" SelectedItem="{Binding ColumnField}" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="ReportColumnFieldCombo" />
                            <ComboBox Grid.Column="2" Grid.Row="3" ItemsSource="{Binding IntervalChoices}" SelectedItem="{Binding ColumnInterval}" MinWidth="120"
                                      AutomationProperties.AutomationId="ReportColumnIntervalCombo" />
                            <TextBlock Grid.Row="4" Classes="label" Text="{l:Tr Common_Value}" />
                            <ComboBox Grid.Row="5" ItemsSource="{Binding ValueFieldNames}" SelectedItem="{Binding ValueField}" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="ReportValueFieldCombo" />
                            <TextBlock Grid.Column="2" Grid.Row="4" Classes="label" Text="{l:Tr Reports_Function}" />
                            <ComboBox Grid.Column="2" Grid.Row="5" ItemsSource="{Binding FunctionChoices}" SelectedItem="{Binding Function}" MinWidth="120"
                                      AutomationProperties.AutomationId="ReportFunctionCombo" />
                        </Grid>
                        <TextBlock Classes="label" Text="{l:Tr Reports_MostColumnsOrSeries1To}" />
                        <TextBox Text="{Binding MaxColumns}" Width="100" HorizontalAlignment="Left" AutomationProperties.AutomationId="ReportMaxColumnsBox" />
                    </StackPanel>

                    <!-- Chart -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsChart}">
                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
                            <TextBlock Classes="label" Text="{l:Tr Reports_ChartType}" />
                            <ComboBox Grid.Row="1" ItemsSource="{Binding ChartTypeChoices}" SelectedItem="{Binding ChartType}" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="ReportChartTypeCombo" />
                            <TextBlock Grid.Column="2" Classes="label" Text="{l:Tr Reports_Order}" />
                            <ComboBox Grid.Column="2" Grid.Row="1" ItemsSource="{Binding ChartOrderChoices}" SelectedItem="{Binding ChartOrder}" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="ReportChartOrderCombo" />
                        </Grid>
                        <TextBlock Classes="label" Text="{l:Tr Reports_MostCategoriesShown0All}" />
                        <TextBox Text="{Binding TopCount}" Width="100" HorizontalAlignment="Left" AutomationProperties.AutomationId="ReportTopCountBox" />
                        <CheckBox Content="{l:Tr Reports_ShowTheDataTableBelowThe}" IsChecked="{Binding ShowDataTable}" AutomationProperties.AutomationId="ReportDataTableCheck" />
                    </StackPanel>

                    <!-- Calendar -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsCalendar}" Margin="0,8,0,0">
                        <TextBlock Classes="label" Text="{l:Tr Reports_DateField}" />
                        <ComboBox ItemsSource="{Binding FieldNames}" SelectedItem="{Binding DateField}" MinWidth="240" AutomationProperties.AutomationId="ReportDateFieldCombo" />
                        <TextBlock Classes="label" Text="{l:Tr Reports_EndDateFieldForRowsThat}" />
                        <ComboBox ItemsSource="{Binding OptionalFieldNames}" SelectedItem="{Binding EndDateField}" MinWidth="240" AutomationProperties.AutomationId="ReportEndDateFieldCombo" />
                        <TextBlock Classes="label" Text="{l:Tr Reports_TitleFieldNoneTheFirstText}" />
                        <ComboBox ItemsSource="{Binding OptionalFieldNames}" SelectedItem="{Binding TitleField}" MinWidth="240" AutomationProperties.AutomationId="ReportTitleFieldCombo" />
                        <WrapPanel>
                            <CheckBox Content="{l:Tr Reports_LinkEntriesToTheViewPage}" Margin="0,0,16,0" IsChecked="{Binding LinkToView}" AutomationProperties.AutomationId="ReportLinkToViewCheck" />
                            <CheckBox Content="{l:Tr Reports_WeeksStartOnMonday}" IsChecked="{Binding WeekStartsMonday}" AutomationProperties.AutomationId="ReportMondayCheck" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Filters shown above the report -->
                    <StackPanel Spacing="4" IsVisible="{Binding HasSource}" Margin="0,8,0,0">
                        <StackPanel Spacing="4" IsVisible="{Binding HasDateRange}">
                            <TextBlock Classes="label" Text="{l:Tr Reports_DateRangeFilterFromAndTo}" />
                            <ComboBox ItemsSource="{Binding DateFieldNames}" SelectedItem="{Binding DateFilterField}" MinWidth="240"
                                      AutomationProperties.AutomationId="ReportDateFilterCombo" />
                        </StackPanel>
                        <TextBlock Classes="label" Text="{l:Tr Reports_PickListFilters}" />
                        <DataGrid ItemsSource="{Binding FilterFields}" SelectedItem="{Binding SelectedFilterField, Mode=TwoWay}" AutoGenerateColumns="False"
                                  GridLinesVisibility="All" SelectionMode="Single" MinHeight="70" MaxHeight="180" HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="ReportFilterFieldsGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:Tr Common_Field}" Width="*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Reports.FieldNames}"
                                                      SelectedItem="{Binding Field}" Margin="2,0" MinWidth="160" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <Button Content="{l:Tr Reports_AddFilter}" Margin="0,0,6,6" Command="{Binding AddFilterFieldCommand}" AutomationProperties.AutomationId="AddReportFilterButton" />
                            <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_Remove}" AutomationProperties.Name="{l:Tr Common_Remove}" Margin="0,0,2,4" Command="{Binding RemoveFilterFieldCommand}" AutomationProperties.AutomationId="RemoveReportFilterButton"><Path Classes="icon" Data="{StaticResource IconRemove}" /></Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Dashboard -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsDashboard}" Margin="0,8,0,0">
                        <TextBlock Classes="label" Text="{l:Tr Reports_ReportsOnTheDashboard}" />
                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" AutoGenerateColumns="False"
                                  GridLinesVisibility="All" SelectionMode="Single" MinHeight="80" MaxHeight="220" HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="DashboardItemsGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:Tr Reports_Report}" Width="*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Reports.DashboardChoices}"
                                                      SelectedItem="{Binding Report}" Margin="2,0" MinWidth="160" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:Tr Reports_Width1To12}" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <NumericUpDown Value="{Binding WidthValue}" Minimum="1" Maximum="12" Increment="1" FormatString="0" Margin="2,0" MinWidth="110" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <Button Content="{l:Tr Reports_AddReport}" Margin="0,0,6,6" Command="{Binding AddItemCommand}" AutomationProperties.AutomationId="AddDashboardItemButton" />
                            <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_Remove}" AutomationProperties.Name="{l:Tr Common_Remove}" Margin="0,0,2,4" Command="{Binding RemoveItemCommand}" AutomationProperties.AutomationId="RemoveDashboardItemButton"><Path Classes="icon" Data="{StaticResource IconRemove}" /></Button>
                        </WrapPanel>
                        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:Tr Reports_12ColumnsFillARowReports}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
