<views:PrefixedControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:WebAppForge.Desktop.Views"
             x:Class="WebAppForge.Desktop.Views.FieldNameListEditor">
    <!-- DataContext: a FieldNameList. -->
    <StackPanel Spacing="4">
        <DataGrid x:Name="FieldsGrid" HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False" GridLinesVisibility="All" SelectionMode="Single" MinHeight="70" MaxHeight="170">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Field" Width="*" MinWidth="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding FieldChoices}" SelectedItem="{Binding Field}" Margin="2,0" MinWidth="150" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel>
            <Button x:Name="AddFieldButton" Content="Add field" Margin="0,0,6,6" Command="{Binding AddCommand}" />
            <Button x:Name="RemoveFieldButton" Content="Remove" Margin="0,0,6,6" Command="{Binding RemoveCommand}" />
            <Button x:Name="MoveFieldUpButton" Content="Move up" Margin="0,0,6,6" Command="{Binding MoveUpCommand}" />
            <Button x:Name="MoveFieldDownButton" Content="Move down" Margin="0,0,6,6" Command="{Binding MoveDownCommand}" />
        </WrapPanel>
    </StackPanel>
</views:PrefixedControl>
