<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:WebAppForge.Desktop.Views"
        x:Class="WebAppForge.Desktop.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="WebAppForge"
        Width="1100" Height="720" MinWidth="800" MinHeight="520">

    <Window.Styles>
        <!-- Pill tabs: each header is a rounded capsule; the selected one is filled with the accent colour. -->
        <Style Selector="TabControl.pills > TabItem">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border" CornerRadius="16" Padding="7,6" Margin="1,4"
                            Background="Transparent">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.pills > TabItem:selected /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="TabControl.pills > TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TabControl.pills > TabItem:selected /template/ ContentPresenter#PART_ContentPresenter TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding ExitCommand}" />
        <KeyBinding Gesture="Ctrl+," Command="{Binding ShowOptionsCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New" Command="{Binding NewProjectCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconNew}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open..." Command="{Binding OpenProjectCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconOpen}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save" Command="{Binding SaveProjectCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconSave}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconSaveAs}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" InputGesture="Ctrl+Q">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconExit}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Connect to database" Command="{Binding Database.ConnectCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconConnect}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Show Tables tab" Command="{Binding ShowTablesTabCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTable}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Show Fields tab" Command="{Binding ShowFieldsTabCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconTable}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Generate" Command="{Binding Generate.GenerateCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconGenerate}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Options..." Command="{Binding ShowOptionsCommand}" InputGesture="Ctrl+,">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconSettings}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Custom styles..." Command="{Binding ChooseCustomStylesCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconStyles}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About WebAppForge" Command="{Binding AboutCommand}">
                    <MenuItem.Icon><Path Classes="icon" Data="{StaticResource IconAbout}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="New" Command="{Binding NewProjectCommand}" />
            <Button Content="Open..." Command="{Binding OpenProjectCommand}" />
            <Button Content="Save" Command="{Binding SaveProjectCommand}" />
            <Button Content="Save As..." Command="{Binding SaveAsCommand}" />
            <TextBlock Text="Project name" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBox Text="{Binding ProjectName}" Width="220" AutomationProperties.AutomationId="ProjectNameBox" />
            <TextBlock Text="Folder:" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBlock Text="{Binding FolderDisplay}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="16,0,8,6" FontWeight="SemiBold" Opacity="0.75"
                   Text="{Binding Breadcrumb}" AutomationProperties.AutomationId="BreadcrumbText" />

        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <!-- Non-blocking: shown after the idle timeout, hidden by the next input. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding IsSessionIdle}">
                    <TextBlock Text="Session idle. Save now?" VerticalAlignment="Center" />
                    <Button Content="Save" Command="{Binding SaveProjectCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl Classes="pills" Margin="8,0,8,0" SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
            <TabItem Header="Database">
                <views:DatabaseView />
            </TabItem>
            <TabItem Header="Tables">
                <views:TablesView />
            </TabItem>
            <TabItem Header="Fields">
                <views:FieldsView />
            </TabItem>
            <TabItem Header="ASP.NET">
                <views:AspNetView />
            </TabItem>
            <TabItem Header="Security">
                <views:SecurityView />
            </TabItem>
            <TabItem Header="Generate">
                <views:GenerateView />
            </TabItem>
            <TabItem Header="Project">
                <views:ProjectSettingsView />
            </TabItem>
            <TabItem Header="Pages">
                <views:PageDesignerView />
            </TabItem>
            <TabItem Header="Languages">
                <views:LanguagesView />
            </TabItem>
            <TabItem Header="Relations">
                <views:RelationsView />
            </TabItem>
            <TabItem Header="Reports">
                <views:ReportsView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
