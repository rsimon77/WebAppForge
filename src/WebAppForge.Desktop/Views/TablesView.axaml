<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebAppForge.Desktop.ViewModels"
             x:Class="WebAppForge.Desktop.Views.TablesView">
    <UserControl.Resources>
        <vm:OwnerFieldChoicesConverter x:Key="OwnerFieldChoices" />
        <vm:OwnerFieldDisplayConverter x:Key="OwnerFieldDisplay" />
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Row classes are set by TablesView.axaml.cs from TableRowRules. -->
        <Style Selector="DataGridRow.row-muted">
            <Setter Property="Background" Value="{DynamicResource RowMutedBackground}" />
        </Style>
        <Style Selector="DataGridRow.row-warning">
            <Setter Property="Background" Value="{DynamicResource RowWarningBackground}" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="12" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,16,300">
        <TextBlock Grid.ColumnSpan="3" Classes="hint" Margin="0,0,0,8"
                   Text="Select a table to edit it on the right, or its fields on the Fields section. Muted rows are not generated; yellow rows have no primary key." />
        <Border Grid.Row="1" Grid.ColumnSpan="3" Classes="banner error" Margin="0,0,0,8" IsVisible="{Binding Security.HasValidationMessage}">
            <TextBlock Classes="error" Text="{Binding Security.ValidationMessage}" />
        </Border>

        <DataGrid Grid.Row="2" HorizontalScrollBarVisibility="Auto" Name="TablesGrid" AutomationProperties.AutomationId="TablesGrid"
                  ItemsSource="{Binding Tables.Items}"
                  SelectedItem="{Binding Tables.SelectedTable, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  LoadingRow="OnRowPrepared"
                  CellEditEnded="OnCellEditEnded">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Table" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="120" FontWeight="Medium" />
                <DataGridCheckBoxColumn Header="Generate" Binding="{Binding Generate}" />
                <DataGridTextColumn Header="Caption" Binding="{Binding Caption}" IsReadOnly="True" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Key" Binding="{Binding Converter={x:Static vm:TableSummary.Key}}" IsReadOnly="True" Width="Auto" />
                <DataGridTextColumn Header="Pages" Binding="{Binding Converter={x:Static vm:TableSummary.Pages}}" IsReadOnly="True" Width="Auto" />
                <DataGridTextColumn Header="Fields" Binding="{Binding Converter={x:Static vm:TableSummary.FieldCount}}" IsReadOnly="True" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Inspector: every setting of the selected table. Edits write the model and refresh the table's row. -->
        <Border Grid.Row="2" Grid.Column="2" Classes="card" Padding="0" VerticalAlignment="Top"
                AutomationProperties.AutomationId="TableInspector">
            <DockPanel DataContext="{Binding Tables.SelectedTable}" IsEnabled="{Binding $parent[UserControl].DataContext.Tables.HasSelectedTable}">
                <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="panelTitle" Text="{Binding Name, FallbackValue='No table selected'}" AutomationProperties.AutomationId="TableInspectorTitle" />
                        <TextBlock Classes="hint" Text="{Binding Converter={x:Static vm:TableSummary.Details}}" />
                    </StackPanel>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,6,16,16">
                        <TextBlock Classes="section" Text="GENERAL" Margin="0,8,0,0" />
                        <TextBlock Classes="label" Text="Caption" />
                        <TextBox Text="{Binding Caption}" LostFocus="OnInspectorEdited" AutomationProperties.AutomationId="TableCaptionBox" />
                        <TextBlock Classes="label" Text="Filter (SQL without WHERE)" />
                        <TextBox Text="{Binding Filter}" FontFamily="{DynamicResource CodeFontFamily}" FontSize="12"
                                 LostFocus="OnInspectorEdited" AutomationProperties.AutomationId="TableFilterBox" />
                        <CheckBox Content="Generate this table" IsChecked="{Binding Generate}" Click="OnInspectorEdited" Margin="0,6,0,0"
                                  AutomationProperties.AutomationId="TableGenerateCheck" />

                        <TextBlock Classes="section" Text="PAGES" Margin="0,16,0,2" />
                        <WrapPanel>
                            <CheckBox Content="List" IsChecked="{Binding Pages.List}" Click="OnInspectorEdited" Margin="0,0,14,0" AutomationProperties.AutomationId="TablePageListCheck" />
                            <CheckBox Content="View" IsChecked="{Binding Pages.View}" Click="OnInspectorEdited" Margin="0,0,14,0" AutomationProperties.AutomationId="TablePageViewCheck" />
                            <CheckBox Content="Add" IsChecked="{Binding Pages.Add}" Click="OnInspectorEdited" Margin="0,0,14,0" AutomationProperties.AutomationId="TablePageAddCheck" />
                            <CheckBox Content="Copy" IsChecked="{Binding Pages.Copy}" Click="OnInspectorEdited" Margin="0,0,14,0" AutomationProperties.AutomationId="TablePageCopyCheck" />
                            <CheckBox Content="Edit" IsChecked="{Binding Pages.Edit}" Click="OnInspectorEdited" Margin="0,0,14,0" AutomationProperties.AutomationId="TablePageEditCheck" />
                            <CheckBox Content="Delete" IsChecked="{Binding Pages.Delete}" Click="OnInspectorEdited" Margin="0,0,14,0" AutomationProperties.AutomationId="TablePageDeleteCheck" />
                            <CheckBox Content="Search" IsChecked="{Binding Pages.Search}" Click="OnInspectorEdited" Margin="0,0,14,0" AutomationProperties.AutomationId="TablePageSearchCheck" />
                        </WrapPanel>
                        <DockPanel Margin="0,6,0,0">
                            <ComboBox DockPanel.Dock="Right" Name="PageSizeCombo" AutomationProperties.AutomationId="PageSizeCombo"
                                      ItemsSource="{Binding $parent[UserControl].DataContext.Tables.PageSizeChoices}"
                                      SelectedItem="{Binding $parent[UserControl].DataContext.Tables.SelectedPageSize, Mode=TwoWay}"
                                      MinWidth="90" />
                            <TextBlock Classes="label" Text="Rows per page" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>

                        <TextBlock Classes="section" Text="ACCESS" Margin="0,16,0,0" />
                        <TextBlock Classes="label" Text="Owner field (rows belong to the signed-in user)" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding Converter={StaticResource OwnerFieldChoices}}"
                                  SelectedItem="{Binding OwnerField, Mode=OneWay, Converter={StaticResource OwnerFieldDisplay}}"
                                  SelectionChanged="OnOwnerFieldSelectionChanged" HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="TableOwnerFieldCombo" />
                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
                            <TextBlock Classes="label" Text="View level" />
                            <TextBox Grid.Row="1" Text="{Binding ViewMinLevel, Mode=OneWay, StringFormat={}{0}}" TextChanged="OnViewLevelTextChanged"
                                     AutomationProperties.AutomationId="TableViewLevelBox" />
                            <TextBlock Grid.Column="2" Classes="label" Text="Edit level" />
                            <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding EditMinLevel, Mode=OneWay, StringFormat={}{0}}" TextChanged="OnEditLevelTextChanged"
                                     AutomationProperties.AutomationId="TableEditLevelBox" />
                        </Grid>
                        <TextBlock Classes="hint" Margin="0,6,0,0" Text="Levels apply when the Security section names a user level field. 0 means any signed-in user." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
