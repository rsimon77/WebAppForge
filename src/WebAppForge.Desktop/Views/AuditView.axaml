<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WebAppForge.Desktop.Localization"
             x:Class="WebAppForge.Desktop.Views.AuditView">
    <Grid DataContext="{Binding Audit}" RowDefinitions="Auto,*" Margin="12">
        <Border Grid.Row="0" Classes="card" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,8">
            <StackPanel Spacing="8">
                <CheckBox Content="{l:Tr Audit_RecordAnAuditTrailWhoInserted}" IsChecked="{Binding Enabled}"
                          AutomationProperties.AutomationId="AuditEnabledCheckBox" />
                <StackPanel IsEnabled="{Binding Enabled}" Spacing="8">
                    <TextBlock Text="{l:Tr Audit_LogTable}" FontWeight="SemiBold" />
                    <TextBox Text="{Binding LogTable}" Width="260" HorizontalAlignment="Left" AutomationProperties.AutomationId="AuditLogTableBox" />
                    <CheckBox Content="{l:Tr Audit_CreateTheLogTableWhenThe}" IsChecked="{Binding CreateTable}" />

                    <TextBlock Text="{l:Tr Audit_ValuesKeptInAnEntry}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding ValueChoices}" SelectedItem="{Binding Values}" Width="260" AutomationProperties.AutomationId="AuditValuesPicker" />
                    <CheckBox Content="{l:Tr Audit_AlsoStoreTheClientSIP}" IsChecked="{Binding RecordIpAddress}" />

                    <CheckBox Content="{l:Tr Audit_AddAPageThatListsThe}" IsChecked="{Binding ShowLogPage}" />
                    <StackPanel Spacing="4" IsEnabled="{Binding ShowLogPage}">
                        <TextBlock Text="{l:Tr Audit_LowestUserLevelThatMayOpen}" />
                        <TextBox Text="{Binding LogPageMinLevelText}" Width="180" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
                <TextBlock IsVisible="{Binding HasInputMessage}" Text="{Binding InputMessage}" Foreground="#B3261E" TextWrapping="Wrap" />
                <Border IsVisible="{Binding HasValidationMessage}" Padding="8" BorderThickness="1" BorderBrush="#B3261E" CornerRadius="4">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#B3261E" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" IsEnabled="{Binding Enabled}">
            <TextBlock DockPanel.Dock="Top" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="{l:Tr Audit_ChooseTheTablesToAuditAnd}" />
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" GridLinesVisibility="All" SelectionMode="Single"
                      HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="AuditTablesGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr Common_Table}" Binding="{Binding Name}" IsReadOnly="True" Width="Auto" MinWidth="140" />
                    <DataGridCheckBoxColumn Header="{l:Tr Audit_Audit}" Binding="{Binding Enabled}" Width="Auto" MinWidth="70" />
                    <DataGridCheckBoxColumn Header="{l:Tr Audit_Inserts}" Binding="{Binding Inserts}" Width="Auto" MinWidth="80" />
                    <DataGridCheckBoxColumn Header="{l:Tr Audit_Updates}" Binding="{Binding Updates}" Width="Auto" MinWidth="80" />
                    <DataGridCheckBoxColumn Header="{l:Tr Audit_Deletes}" Binding="{Binding Deletes}" Width="Auto" MinWidth="80" />
                    <DataGridTextColumn Header="{l:Tr Common_ExcludedFields}" Binding="{Binding ExcludedText}" Width="*" MinWidth="160" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
