<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WebAppForge.Desktop.Localization"
             x:Class="WebAppForge.Desktop.Views.SecurityView">
    <Border Classes="card" Margin="12" MaxWidth="600" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Spacing="8">
            <CheckBox Content="{l:Tr Security_RequireSignInCookieLoginAgainst}" IsChecked="{Binding Security.Enabled}"
                      AutomationProperties.AutomationId="SignInCheckBox" />

            <TextBlock Text="{l:Tr Security_UserStore}" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Security.UserStoreChoices}" SelectedItem="{Binding Security.UserStoreChoice}"
                      IsEnabled="{Binding Security.Enabled}" HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="UserStoreComboBox" />

            <!-- The groups below are accordions: each can be collapsed to keep the tab short. -->
            <Expander Header="{l:Tr Security_ASPNETCoreIdentity}" IsExpanded="True" HorizontalAlignment="Stretch"
                      IsVisible="{Binding Security.IsIdentity}" AutomationProperties.AutomationId="IdentityExpander">
                <StackPanel Spacing="8" Margin="0,4,0,0">
                    <CheckBox Content="{l:Tr Security_CreateMissingIdentityTablesWhenThe}" IsChecked="{Binding Security.CreateTablesAtStartup}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:Tr Security_TablePrefix}" />
                            <TextBox Width="180" Text="{Binding Security.TablePrefix}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:Tr Security_MinimumPasswordLength}" />
                            <TextBox Width="180" Text="{Binding Security.MinPasswordLengthText}" />
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel>
                        <CheckBox Content="{l:Tr Security_RequireADigit}" IsChecked="{Binding Security.RequireDigit}" Margin="0,0,16,0" />
                        <CheckBox Content="{l:Tr Security_RequireAnUppercaseLetter}" IsChecked="{Binding Security.RequireUppercase}" Margin="0,0,16,0" />
                        <CheckBox Content="{l:Tr Security_RequireALowercaseLetter}" IsChecked="{Binding Security.RequireLowercase}" Margin="0,0,16,0" />
                        <CheckBox Content="{l:Tr Security_RequireASymbol}" IsChecked="{Binding Security.RequireNonAlphanumeric}" />
                    </WrapPanel>
                    <CheckBox Content="{l:Tr Security_RequireAConfirmedEMailAddress}" IsChecked="{Binding Security.RequireConfirmedEmail}" />

                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:Tr Security_AdministratorUserName}" />
                            <TextBox Width="180" Text="{Binding Security.AdminUserName}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:Tr Security_PasswordEnvironmentVariable}" />
                            <TextBox Width="260" Text="{Binding Security.AdminPasswordVariable}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:Tr Security_AdministratorLevel}" />
                            <TextBox Width="180" Text="{Binding Security.AdminLevelText}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:Tr Security_LevelOfNewUsers}" />
                            <TextBox Width="180" Text="{Binding Security.RegisteredUserLevelText}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Text="{l:Tr Security_TheSiteCreatesTheAdministratorWhen}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="{l:Tr Security_CreateMissingTables}" Command="{Binding Security.CreateIdentityTablesCommand}"
                                IsEnabled="{Binding !Security.IdentityBusy}"
                                AutomationProperties.AutomationId="CreateIdentityTablesButton" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding Security.HasIdentityTablesMessage}" Text="{Binding Security.IdentityTablesMessage}"
                               TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding Security.HasIdentityNotes}" Text="{Binding Security.IdentityNotes}"
                               TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </Expander>

            <Expander Header="{l:Tr Security_LoginOptions}" IsExpanded="True" HorizontalAlignment="Stretch" IsVisible="{Binding Security.IsProjectTable}">
                <StackPanel Spacing="8" Margin="0,4,0,0">
                    <TextBlock Text="{l:Tr Security_UserTable}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Security.UserTables}"
                              SelectedItem="{Binding Security.UserTable}"
                              PlaceholderText="{l:Tr Security_ChooseATableMarkedGenerate}"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="{l:Tr Security_UserNameField}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding Security.UserNameFields}"
                              SelectedItem="{Binding Security.UserNameField}"
                              PlaceholderText="{l:Tr Security_ChooseAFieldOfTheUser}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>
            </Expander>

            <Expander Header="{l:Tr Security_PasswordOptions}" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Margin="0,4,0,0">
                    <TextBlock Text="{l:Tr Security_PasswordFieldStoresThePasswordHash}" FontWeight="SemiBold" IsVisible="{Binding Security.IsProjectTable}" />
                    <ComboBox ItemsSource="{Binding Security.PasswordFields}"
                              SelectedItem="{Binding Security.PasswordField}"
                              PlaceholderText="{l:Tr Security_ChooseAFieldOfTheUser}"
                              IsVisible="{Binding Security.IsProjectTable}"
                              HorizontalAlignment="Stretch" />

                    <CheckBox Content="{l:Tr Security_TrackFailedSignInAttempts}" IsChecked="{Binding Security.TrackFailedAttempts}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="16" IsEnabled="{Binding Security.TrackFailedAttempts}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:Tr Security_MaxFailedAttempts}" />
                            <TextBox Width="180" Text="{Binding Security.MaxFailedAttemptsText}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:Tr Security_WindowMinutes}" />
                            <TextBox Width="180" Text="{Binding Security.FailedAttemptsWindowText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="{l:Tr Security_Permissions}" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Margin="0,4,0,0">
                    <TextBlock Text="{l:Tr Security_LevelFieldIntegerOptionalEnablesUser}" FontWeight="SemiBold" IsVisible="{Binding Security.IsProjectTable}" />
                    <ComboBox ItemsSource="{Binding Security.UserLevelFields}"
                              SelectedItem="{Binding Security.LevelField}"
                              IsEnabled="{Binding Security.Enabled}"
                              IsVisible="{Binding Security.IsProjectTable}"
                              HorizontalAlignment="Stretch" />

                    <CheckBox Content="{l:Tr Security_AllowRegistrationNewUsersCanSign}" IsChecked="{Binding Security.AllowRegistration}"
                              IsEnabled="{Binding Security.Enabled}" Margin="0,8,0,0" />
                    <CheckBox Content="{l:Tr Security_AllowChangePasswordSignedInUsers}" IsChecked="{Binding Security.AllowChangePassword}"
                              IsEnabled="{Binding Security.Enabled}" />
                </StackPanel>
            </Expander>

            <TextBlock IsVisible="{Binding Security.HasInputMessage}" Text="{Binding Security.InputMessage}"
                       Foreground="#B3261E" TextWrapping="Wrap" />

            <Border IsVisible="{Binding Security.HasValidationMessage}" Padding="8" Margin="0,8,0,0"
                    BorderThickness="1" BorderBrush="#B3261E" CornerRadius="4">
                <TextBlock Text="{Binding Security.ValidationMessage}" Foreground="#B3261E" TextWrapping="Wrap" />
            </Border>

            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0"
                       Text="{l:Tr Security_WhenSignInIsEnabledEvery}" />
        </StackPanel>
    </Border>
</UserControl>
