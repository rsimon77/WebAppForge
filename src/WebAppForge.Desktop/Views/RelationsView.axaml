<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WebAppForge.Desktop.Localization"
             x:Class="WebAppForge.Desktop.Views.RelationsView">
    <Grid DataContext="{Binding Relations}" RowDefinitions="Auto,*" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" MinWidth="340" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="6*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <!-- Top bar: the master table, suggestions from foreign keys and messages. -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{l:Tr Relations_MasterTable}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Tables.Items}" SelectedItem="{Binding Tables.SelectedTable, Mode=TwoWay}"
                          PlaceholderText="{l:Tr Common_ChooseATable}" MinWidth="220" AutomationProperties.AutomationId="RelationsTablePicker">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{l:Tr Relations_SuggestFromForeignKeys}" Command="{Binding SuggestFromForeignKeysCommand}"
                        AutomationProperties.AutomationId="SuggestFromForeignKeysButton" />
            </StackPanel>
            <TextBlock Classes="hint" IsVisible="{Binding HasSuggestMessage}" Text="{Binding SuggestMessage}"
                       AutomationProperties.AutomationId="SuggestMessageText" />
            <TextBlock Classes="hint" Text="{Binding MasterNote}" IsVisible="{Binding HasMasterNote}"
                       AutomationProperties.AutomationId="MasterNoteText" />
            <Border IsVisible="{Binding HasMessage}" Classes="banner error">
                <TextBlock Classes="error" Text="{Binding Message}" AutomationProperties.AutomationId="RelationsMessageText" />
            </Border>
        </StackPanel>

        <!-- Left: the detail links of the master table, the overview of all links and the validation list. -->
        <Border Classes="card" Padding="12,10" Grid.Row="1" Grid.Column="0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8" Margin="0,0,8,0" IsEnabled="{Binding HasTable}">
                    <TextBlock Classes="label" Text="{l:Tr Relations_DetailLinksOfTheMasterTable}" />
                    <ListBox ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink, Mode=TwoWay}" MinHeight="90" MaxHeight="220"
                             AutomationProperties.AutomationId="DetailLinkList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel>
                        <Button Content="{l:Tr Relations_AddLink}" Margin="0,0,6,6" Command="{Binding AddLinkCommand}" AutomationProperties.AutomationId="AddLinkButton" />
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_Remove}" AutomationProperties.Name="{l:Tr Common_Remove}" Margin="0,0,2,4" Command="{Binding RemoveLinkCommand}" AutomationProperties.AutomationId="RemoveLinkButton"><Path Classes="icon" Data="{StaticResource IconRemove}" /></Button>
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_MoveUp}" AutomationProperties.Name="{l:Tr Common_MoveUp}" Margin="0,0,2,4" Command="{Binding MoveLinkUpCommand}" AutomationProperties.AutomationId="MoveLinkUpButton"><Path Classes="icon" Data="{StaticResource IconUp}" /></Button>
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_MoveDown}" AutomationProperties.Name="{l:Tr Common_MoveDown}" Margin="0,0,2,4" Command="{Binding MoveLinkDownCommand}" AutomationProperties.AutomationId="MoveLinkDownButton"><Path Classes="icon" Data="{StaticResource IconDown}" /></Button>
                    </WrapPanel>

                    <Expander Header="{l:Tr Relations_RelationsOverview}" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <TextBlock Classes="hint" Text="{l:Tr Relations_EveryLinkOfTheProjectMaster}" />
                            <ListBox ItemsSource="{Binding Overview}" SelectedItem="{Binding SelectedOverview, Mode=TwoWay}" MinHeight="70" MaxHeight="200"
                                     DoubleTapped="OnOverviewDoubleTapped" AutomationProperties.AutomationId="RelationsOverviewList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Expander>

                    <Expander Header="{l:Tr Common_Validation}" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <TextBlock Classes="hint" Text="{Binding IssueSummary}" AutomationProperties.AutomationId="RelationIssueSummaryText" />
                            <ItemsControl ItemsSource="{Binding Issues}" AutomationProperties.AutomationId="RelationIssueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes.error="{Binding IsError}" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" />

        <!-- Right: the selected link. -->
        <Border Classes="card" Padding="12,10" Grid.Row="1" Grid.Column="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" Margin="0,0,8,0" IsEnabled="{Binding HasLink}">
                    <TextBlock Classes="label" Text="{l:Tr Relations_DetailTable}" />
                    <ComboBox ItemsSource="{Binding DetailTableNames}" SelectedItem="{Binding DetailTable}" MinWidth="240"
                              AutomationProperties.AutomationId="DetailTableCombo" />
                    <TextBlock Classes="hint" Text="{l:Tr Relations_TheMasterItselfIsAllowedA}" />

                    <TextBlock Classes="label" Text="{l:Tr Relations_KeyLinksMasterFieldDetailField}" />
                    <DataGrid HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding KeyPairs}" SelectedItem="{Binding SelectedKeyPair, Mode=TwoWay}"
                              AutoGenerateColumns="False" GridLinesVisibility="All" SelectionMode="Single" MinHeight="80" MaxHeight="180"
                              AutomationProperties.AutomationId="KeyPairsGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Tr Relations_MasterField}" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Relations.MasterFieldNames}"
                                                  SelectedItem="{Binding MasterField}" Margin="2,0" MinWidth="130" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Tr Common_Type}" Binding="{Binding MasterType}" IsReadOnly="True" Width="Auto" />
                            <DataGridTemplateColumn Header="{l:Tr Relations_DetailField}" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Relations.DetailFieldNames}"
                                                  SelectedItem="{Binding DetailField}" Margin="2,0" MinWidth="130" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Tr Common_Type}" Binding="{Binding DetailType}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="{l:Tr Relations_Note}" Binding="{Binding TypeNote}" IsReadOnly="True" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel>
                        <Button Content="{l:Tr Relations_AddKeyLink}" Margin="0,0,6,6" Command="{Binding AddKeyPairCommand}" AutomationProperties.AutomationId="AddKeyPairButton" />
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_Remove}" AutomationProperties.Name="{l:Tr Common_Remove}" Margin="0,0,2,4" Command="{Binding RemoveKeyPairCommand}" AutomationProperties.AutomationId="RemoveKeyPairButton"><Path Classes="icon" Data="{StaticResource IconRemove}" /></Button>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding LinkIssues}" IsVisible="{Binding HasLinkIssues}"
                                  AutomationProperties.AutomationId="LinkIssuesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="error" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="label" Text="{l:Tr Relations_CaptionEmptyTheDetailTableS}" />
                    <TextBox Text="{Binding Caption}" AutomationProperties.AutomationId="LinkCaptionBox" />
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="{l:Tr Relations_ShowOnView}" Margin="0,0,16,0" IsChecked="{Binding ShowOnView}" AutomationProperties.AutomationId="ShowOnViewCheck" />
                        <CheckBox Content="{l:Tr Relations_ShowOnEdit}" Margin="0,0,16,0" IsChecked="{Binding ShowOnEdit}" AutomationProperties.AutomationId="ShowOnEditCheck" />
                        <CheckBox Content="{l:Tr Relations_AfterAddGoToEdit}" IsChecked="{Binding AfterAddGoToEdit}" AutomationProperties.AutomationId="AfterAddGoToEditCheck" />
                    </WrapPanel>

                    <TextBlock Classes="label" Text="{l:Tr Relations_PreviewOnTheMasterSList}" />
                    <ComboBox ItemsSource="{Binding PreviewChoices}" SelectedItem="{Binding PreviewChoice}" MinWidth="200"
                              AutomationProperties.AutomationId="PreviewModeCombo" />

                    <TextBlock Classes="label" Text="{l:Tr Relations_OnDeleteOfAMasterRecord}" />
                    <ComboBox ItemsSource="{Binding DeleteRuleOptions}" SelectedItem="{Binding OnDeleteOption}" MinWidth="200"
                              AutomationProperties.AutomationId="OnDeleteCombo">
                        <ComboBox.Styles>
                            <Style Selector="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            </Style>
                        </ComboBox.Styles>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="hint" Text="{Binding OnDeleteExplanation}" AutomationProperties.AutomationId="OnDeleteExplanationText" />
                    <TextBlock Classes="error" Text="{Binding SetNullNote}" IsVisible="{Binding HasSetNullNote}"
                               AutomationProperties.AutomationId="SetNullNoteText" />

                    <TextBlock Classes="label" Text="{l:Tr Relations_OnUpdateOfALinkedMaster}" />
                    <ComboBox ItemsSource="{Binding UpdateChoices}" SelectedItem="{Binding UpdateChoice}" MinWidth="200"
                              AutomationProperties.AutomationId="OnUpdateCombo" />
                    <TextBlock Classes="error" Text="{Binding UpdateNote}" IsVisible="{Binding HasUpdateNote}"
                               AutomationProperties.AutomationId="UpdateNoteText" />

                    <TextBlock Classes="label" Text="{l:Tr Relations_DetailGridColumnsNoneTheDetail}" />
                    <DataGrid HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                              AutoGenerateColumns="False" GridLinesVisibility="All" SelectionMode="Single" MinHeight="80" MaxHeight="200"
                              AutomationProperties.AutomationId="DetailColumnsGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Tr Common_Field}" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Relations.DetailFieldNames}"
                                                  SelectedItem="{Binding Field}" Margin="2,0" MinWidth="160" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel>
                        <Button Content="{l:Tr Common_AddColumn}" Margin="0,0,6,6" Command="{Binding AddColumnCommand}" AutomationProperties.AutomationId="AddDetailColumnButton" />
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_Remove}" AutomationProperties.Name="{l:Tr Common_Remove}" Margin="0,0,2,4" Command="{Binding RemoveColumnCommand}" AutomationProperties.AutomationId="RemoveDetailColumnButton"><Path Classes="icon" Data="{StaticResource IconRemove}" /></Button>
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_MoveUp}" AutomationProperties.Name="{l:Tr Common_MoveUp}" Margin="0,0,2,4" Command="{Binding MoveColumnUpCommand}" AutomationProperties.AutomationId="MoveDetailColumnUpButton"><Path Classes="icon" Data="{StaticResource IconUp}" /></Button>
                        <Button Classes="icon ghost" ToolTip.Tip="{l:Tr Common_MoveDown}" AutomationProperties.Name="{l:Tr Common_MoveDown}" Margin="0,0,2,4" Command="{Binding MoveColumnDownCommand}" AutomationProperties.AutomationId="MoveDetailColumnDownButton"><Path Classes="icon" Data="{StaticResource IconDown}" /></Button>
                    </WrapPanel>

                    <TextBlock Classes="label" Text="{l:Tr Relations_PageSize1To200}" />
                    <TextBox Text="{Binding PageSizeText}" Width="100" HorizontalAlignment="Left" AutomationProperties.AutomationId="DetailPageSizeBox" />
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="{l:Tr Relations_AllowAdd}" Margin="0,0,16,0" IsChecked="{Binding AllowAdd}" AutomationProperties.AutomationId="AllowAddCheck" />
                        <CheckBox Content="{l:Tr Relations_AllowEdit}" Margin="0,0,16,0" IsChecked="{Binding AllowEdit}" AutomationProperties.AutomationId="AllowEditCheck" />
                        <CheckBox Content="{l:Tr Relations_AllowDelete}" IsChecked="{Binding AllowDelete}" AutomationProperties.AutomationId="AllowDeleteCheck" />
                    </WrapPanel>
                    <CheckBox Content="{l:Tr Relations_QuickFilterAndColumnSortingOn}" IsChecked="{Binding FilterAndSort}" AutomationProperties.AutomationId="DetailFilterAndSortCheck"
                              ToolTip.Tip="{l:Tr Relations_AQuickFilterBoxSortableColumn}" />

                    <TextBlock Classes="label" Text="{l:Tr Relations_FormPageThatHoldsTheGrid}" />
                    <ComboBox ItemsSource="{Binding FormPageChoices}" SelectedItem="{Binding FormPageChoice}" MinWidth="200"
                              AutomationProperties.AutomationId="LinkFormPageCombo" />
                    <TextBlock Classes="hint" Text="{l:Tr Relations_FormPagesAreDefinedOnThe}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
