<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WebAppForge.Desktop.Localization"
             x:Class="WebAppForge.Desktop.Views.ImportExportView">
    <Grid DataContext="{Binding ImportExport}" RowDefinitions="Auto,*" Margin="12">
        <Border Grid.Row="0" Classes="card" MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,0,8">
            <StackPanel Spacing="8">
                <CheckBox Content="{l:Tr ImportExport_LetUsersExportListRowsAnd}" IsChecked="{Binding Enabled}"
                          AutomationProperties.AutomationId="ImportExportEnabledCheckBox" />
                <Grid IsEnabled="{Binding Enabled}" ColumnDefinitions="Auto,24,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{l:Tr ImportExport_FileFormats}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Formats}" AutomationProperties.AutomationId="ImportExportFormats">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="120,90,90">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" Content="{l:Tr ImportExport_Export}" IsChecked="{Binding Export}" />
                                        <CheckBox Grid.Column="2" Content="{l:Tr ImportExport_Import}" IsChecked="{Binding Import}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <WrapPanel Grid.Column="2" Orientation="Horizontal">
                        <StackPanel Spacing="4" Margin="0,0,16,8" Width="200">
                            <TextBlock Text="{l:Tr ImportExport_ColumnHeaders}" />
                            <ComboBox ItemsSource="{Binding HeaderStyleChoices}" SelectedItem="{Binding HeaderStyle}" HorizontalAlignment="Stretch" />
                            <CheckBox Content="{l:Tr ImportExport_WriteAHeaderRow}" IsChecked="{Binding IncludeHeader}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8" Width="200">
                            <TextBlock Text="{l:Tr ImportExport_CSVDelimiterOneCharacterOrTab}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding CsvDelimiter}" AutomationProperties.AutomationId="ImportExportDelimiterBox" />
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8" Width="200">
                            <TextBlock Text="{l:Tr ImportExport_DateFormat}" />
                            <TextBox Text="{Binding DateFormat}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8" Width="200">
                            <TextBlock Text="{l:Tr ImportExport_ExportFileNameTableDateDatetime}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding FileNamePattern}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8" Width="200">
                            <TextBlock Text="{l:Tr ImportExport_LargestUploadMB}" />
                            <TextBox Text="{Binding MaxUploadText}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8" Width="200">
                            <TextBlock Text="{l:Tr ImportExport_LowestUserLevelToExport}" />
                            <TextBox Text="{Binding ExportMinLevelText}" />
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="0,0,16,8" Width="200">
                            <TextBlock Text="{l:Tr ImportExport_LowestUserLevelToImport}" />
                            <TextBox Text="{Binding ImportMinLevelText}" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
                <TextBlock IsVisible="{Binding HasInputMessage}" Text="{Binding InputMessage}" Foreground="#B3261E" TextWrapping="Wrap" />
                <Border IsVisible="{Binding HasValidationMessage}" Padding="8" BorderThickness="1" BorderBrush="#B3261E" CornerRadius="4">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#B3261E" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" IsEnabled="{Binding Enabled}">
            <TextBlock DockPanel.Dock="Top" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="{l:Tr ImportExport_ChoosePerTableWhetherItExports}" />
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" GridLinesVisibility="All" SelectionMode="Single"
                      HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ImportExportTablesGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr Common_Table}" Binding="{Binding Name}" IsReadOnly="True" Width="Auto" MinWidth="140" />
                    <DataGridCheckBoxColumn Header="{l:Tr ImportExport_Export}" Binding="{Binding Export}" Width="Auto" MinWidth="70" />
                    <DataGridCheckBoxColumn Header="{l:Tr ImportExport_Import}" Binding="{Binding Import}" Width="Auto" MinWidth="70" />
                    <DataGridTemplateColumn Header="{l:Tr ImportExport_ImportMode}" Width="Auto" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding ModeChoices}"
                                          SelectedItem="{Binding ImportMode}" HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:Tr ImportExport_MostExportRows0All}" Binding="{Binding ExportMaxRowsText}" Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="{l:Tr Common_ExcludedFields}" Binding="{Binding ExcludedText}" Width="*" MinWidth="160" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
