<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebAppForge.Desktop.ViewModels"
             xmlns:views="using:WebAppForge.Desktop.Views"
             x:Class="WebAppForge.Desktop.Views.ReportsView">
    <Grid DataContext="{Binding Reports}" RowDefinitions="Auto,*" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="260" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="7*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" IsVisible="{Binding HasMessage}" Padding="8" Margin="0,0,0,8" BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource ValidationBrush}">
            <TextBlock Classes="error" Text="{Binding Message}" AutomationProperties.AutomationId="ReportsMessageText" />
        </Border>

        <!-- Left: the report list. -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
            <TextBox DockPanel.Dock="Top" Text="{Binding SearchText}" PlaceholderText="Search reports" AutomationProperties.AutomationId="ReportSearchBox" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                <Button Content="Add..." Margin="0,0,6,6" Command="{Binding AddReportCommand}" AutomationProperties.AutomationId="AddReportButton" />
                <Button Content="Duplicate" Margin="0,0,6,6" Command="{Binding DuplicateReportCommand}" AutomationProperties.AutomationId="DuplicateReportButton" />
                <Button Content="Delete" Margin="0,0,6,6" Command="{Binding DeleteReportCommand}" AutomationProperties.AutomationId="DeleteReportButton" />
                <Button Content="Move up" Margin="0,0,6,6" Command="{Binding MoveReportUpCommand}" AutomationProperties.AutomationId="MoveReportUpButton" />
                <Button Content="Move down" Margin="0,0,6,6" Command="{Binding MoveReportDownCommand}" AutomationProperties.AutomationId="MoveReportDownButton" />
            </WrapPanel>
            <Expander DockPanel.Dock="Bottom" Header="Validation (all reports)" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock Classes="hint" Text="{Binding IssueSummary}" AutomationProperties.AutomationId="ReportIssueSummaryText" />
                    <ItemsControl ItemsSource="{Binding Issues}" AutomationProperties.AutomationId="ReportIssueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes.error="{Binding IsError}" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
            <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport, Mode=TwoWay}" MinHeight="140"
                     AutomationProperties.AutomationId="ReportList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{Binding TypeIcon}" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" />
                                <TextBlock Classes="hint" FontSize="11">
                                    <Run Text="{Binding TypeText}" /><Run Text=" - " /><Run Text="{Binding TableText}" /><Run Text="  " /><Run Text="{Binding IconName}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" />

        <!-- Right: settings, designer, schematic preview and the preview run of the selected report. -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8" Margin="0,0,8,0">
                <TextBlock Classes="hint" Text="Select a report on the left, or add one." IsVisible="{Binding !HasReport}"
                           AutomationProperties.AutomationId="NoReportText" />

                <StackPanel Spacing="8" IsVisible="{Binding HasReport}">
                    <TextBlock Text="{Binding HeaderText}" FontSize="16" FontWeight="SemiBold" AutomationProperties.AutomationId="ReportHeaderText" />
                    <TextBlock Classes="hint" Text="{Binding TypeDescription}" />

                    <Expander Header="Report settings" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <WrapPanel>
                                <StackPanel Spacing="2" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Name (web address, letters and digits)" />
                                    <TextBox Text="{Binding Name}" Width="220" AutomationProperties.AutomationId="ReportNameBox" />
                                </StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Caption" />
                                    <TextBox Text="{Binding Caption}" Width="260" AutomationProperties.AutomationId="ReportCaptionBox" />
                                </StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,16,6" IsVisible="{Binding ShowTable}">
                                    <TextBlock Classes="label" Text="Source table" />
                                    <ComboBox ItemsSource="{Binding TableNames}" SelectedItem="{Binding TableName}" MinWidth="200"
                                              PlaceholderText="Choose a table" AutomationProperties.AutomationId="ReportTableCombo" />
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding ShowTable}">
                                <TextBlock Classes="label" Text="SQL filter (a condition without WHERE, always applied)" />
                                <TextBox Classes="code" Text="{Binding Filter}" MinHeight="60" Height="70" AutomationProperties.AutomationId="ReportFilterBox" />
                                <TextBlock Classes="hint" Text="Example: Status = 'Open' AND Total > 100. Write only the condition; the generated query adds WHERE." />
                            </StackPanel>

                            <TextBlock Classes="label" Text="Description" />
                            <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" AutomationProperties.AutomationId="ReportDescriptionBox" />

                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox Content="Show in menu" Margin="0,0,16,6" IsChecked="{Binding ShowInMenu}" AutomationProperties.AutomationId="ReportShowInMenuCheck" />
                                <StackPanel Spacing="2" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Menu group" />
                                    <TextBox Text="{Binding MenuGroup}" Width="180" AutomationProperties.AutomationId="ReportMenuGroupBox" />
                                </StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Menu order" />
                                    <TextBox Text="{Binding MenuOrderText}" Width="90" AutomationProperties.AutomationId="ReportMenuOrderBox" />
                                </StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Minimum level" />
                                    <TextBox Text="{Binding MinLevelText}" Width="90" AutomationProperties.AutomationId="ReportMinLevelBox" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Classes="label" Text="Icon (Bootstrap Icons name, pick one or type any)" />
                            <ComboBox ItemsSource="{Binding IconChoices}" Text="{Binding Icon}" IsEditable="True" MinWidth="240"
                                      AutomationProperties.AutomationId="ReportIconCombo" />
                            <StackPanel Spacing="4" IsVisible="{Binding ShowTable}">
                                <TextBlock Classes="label" Text="Drill-down (opened when a group, cell, point or event is clicked)" />
                                <ComboBox ItemsSource="{Binding DrillDownChoices}" SelectedItem="{Binding DrillDownChoice}" MinWidth="240"
                                          AutomationProperties.AutomationId="ReportDrillDownCombo" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Designer" IsExpanded="True" HorizontalAlignment="Stretch">
                        <ContentControl Content="{Binding Designer}" Margin="0,4,0,0" AutomationProperties.AutomationId="ReportDesignerHost" />
                    </Expander>

                    <Expander Header="Schematic preview" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <TextBlock Classes="hint" Text="A rough picture with sample data. It follows every change." />
                            <views:ReportSchematicPreview Schematic="{Binding Schematic}" AutomationProperties.AutomationId="ReportSchematicPreview" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Run preview" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <WrapPanel>
                                <Button Content="Run preview" Margin="0,0,6,6" Command="{Binding RunPreviewCommand}" AutomationProperties.AutomationId="RunPreviewButton" />
                                <Button Content="Cancel" Margin="0,0,6,6" Command="{Binding CancelPreviewCommand}" IsEnabled="{Binding IsPreviewRunning}"
                                        AutomationProperties.AutomationId="CancelPreviewButton" />
                            </WrapPanel>
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPreviewRunning}" />
                            <TextBlock Classes="error" Text="{Binding PreviewError}" IsVisible="{Binding HasPreviewError}" AutomationProperties.AutomationId="PreviewErrorText" />
                            <TextBlock Classes="hint" Text="{Binding PreviewSummary}" AutomationProperties.AutomationId="PreviewSummaryText" />
                            <DataGrid x:Name="PreviewGrid" HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding PreviewRows}"
                                      AutoGenerateColumns="False" GridLinesVisibility="All" IsReadOnly="True" MinHeight="90" MaxHeight="300"
                                      AutomationProperties.AutomationId="PreviewGrid" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Problems with this report" IsExpanded="True" HorizontalAlignment="Stretch" IsVisible="{Binding HasSelectedIssues}">
                        <ItemsControl ItemsSource="{Binding SelectedIssues}" Margin="0,4,0,0" AutomationProperties.AutomationId="SelectedReportIssueList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Classes.error="{Binding IsError}" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
