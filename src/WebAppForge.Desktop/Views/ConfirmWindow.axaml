<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WebAppForge.Desktop.Localization"
        x:Class="WebAppForge.Desktop.Views.ConfirmWindow"
        Title="{l:Tr Confirm_Confirm}"
        Width="440" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="ConfirmButton" AutomationProperties.AutomationId="ConfirmButton" IsDefault="True" Click="OnConfirmClick" />
            <Button Content="{l:Tr Common_Cancel}" AutomationProperties.AutomationId="ConfirmCancelButton" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
